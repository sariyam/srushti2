
# ==============================================================================
# SRUSHTI AI FRONTEND — ENVIRONMENT CONFIGURATION
# Vite requires variables accessible in the browser to be prefixed with 'VITE_'
# ==============================================================================

# 1. Backend Serverless API Base URL
# Local Development: http://localhost:4000
# Production Deployment: https://your-serverless-backend.vercel.app
VITE_SERVER_BASE_URL="http://localhost:4002"
VITE_API_URL="http://localhost:4002/api"

#VITE_SERVER_BASE_URL="https://xfooqaqjeaqcoddihphl.supabase.co/functions/v1"
#VITE_API_URL="https://xfooqaqjeaqcoddihphl.supabase.co/functions/v1/api"

# 2. OpenAI API Credentials
# NOTE: OpenAI API Key is stored securely on the server-side in supabase/functions/.env.
# Do NOT prefix with VITE_ to avoid exposing secrets to client browser bundles.

# 3. Application Public Hosting URL
# Local: http://localhost:3000 | Production:https://srushtiai.in
VITE_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/srushti"
#VITE_APP_URL="https://srushtiai.in"
#APP_URL="https://srushtiai.in"