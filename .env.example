# ==============================================================================
# SRUSHTI AI FRONTEND — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env before starting development or deploying
# ==============================================================================

# 1. Backend Serverless API Base URL
# Local Development: http://localhost:4000
# Production Deployment: https://your-serverless-backend.vercel.app
VITE_SERVER_BASE_URL="http://localhost:4000"
VITE_API_URL="http://localhost:4000/api"

# 2. OpenAI API Credentials
# Used for GPTImage-2 and Sora 2 AI studio generation
VITE_OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"

# 3. Application Public Hosting URL
# Local: http://localhost:3000 | Production: https://srushti.ai
VITE_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
